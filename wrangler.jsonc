{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bend-and-brew-rewards",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }
}
